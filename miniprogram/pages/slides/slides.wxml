<view class="page">
  <view wx:if="{{loading}}" class="empty-tip">正在加载课件…</view>
  <view wx:if="{{error}}" class="error-box">{{error}}</view>

  <block wx:if="{{!loading && presentations.length > 0}}">
    <!-- 测验区：题目置顶（全屏时隐藏） -->
    <view wx:if="{{!fullscreen && quizItems.length > 0}}" class="quiz-panel">
      <view class="quiz-header" bindtap="toggleQuiz">
        <view class="quiz-title-wrap">
          <text class="quiz-icon">题</text>
          <view>
            <text class="quiz-title">教师题目 · 测验区</text>
            <text class="quiz-sub">共 {{quizItems.length}} 道 · 点击查看</text>
          </view>
        </view>
        <text class="fold">{{showQuiz ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{showQuiz}}" class="quiz-list">
        <view class="quiz-item {{q.active ? 'active' : ''}}" wx:for="{{quizItems}}" wx:key="idx"
              data-pi="{{item.presIdx}}" data-si="{{item.slideIdx}}" bindtap="jumpTo">
          <view class="quiz-item-head">
            <text class="q-badge">题{{index + 1}}</text>
            <text class="q-type-tag">{{item.typeName}}</text>
            <text class="q-meta">{{item.presTitle}} · P{{item.page}}</text>
            <text wx:if="{{item.answer}}" class="q-answer-badge">参考答案：{{item.answer}}</text>
          </view>
          <!-- 用 rich-text 完整渲染题目 HTML（公式/图片/格式不丢失），无 HTML 时回退纯文本 -->
          <rich-text wx:if="{{item.bodyHtml}}" class="q-body-rich" nodes="{{item.bodyHtml}}"></rich-text>
          <text wx:else class="q-body">{{item.body || '（题目内容见课件图片）'}}</text>
          <!-- 选项列表：正确答案绿色高亮（与 Web 版一致） -->
          <view wx:if="{{item.optionList.length > 0}}" class="q-options">
            <view class="q-option {{opt.isAnswer ? 'correct' : ''}}"
                  wx:for="{{item.optionList}}" wx:for-item="opt" wx:key="key">
              <text class="opt-key">{{opt.key}}</text>
              <text class="opt-val">{{opt.value}}</text>
              <text wx:if="{{opt.isAnswer}}" class="opt-check">✓</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 课件主体：PPT 铺满手机宽度，缩略图预览与切换栏放到下方 -->
    <view class="viewer {{fullscreen ? 'fullscreen' : ''}} {{landscape && !fullscreen ? 'landscape' : ''}}">
      <!-- PPT 舞台区 -->
      <view class="stage {{landscape && !fullscreen ? 'landscape' : ''}}">
        <!-- 控制按钮组：全屏/退出、横竖屏、缩放（仅全屏时显示横竖屏与缩放） -->
        <view class="ctrl-bar">
          <view class="fs-btn" catchtap="toggleFullscreen">
            <text class="fs-icon">{{fullscreen ? '×' : '⛶'}}</text>
            <text class="fs-label">{{fullscreen ? '退出' : '全屏'}}</text>
          </view>
          <block wx:if="{{fullscreen}}">
            <view class="fs-btn" catchtap="toggleOrientation">
              <text class="fs-icon">{{landscape ? '▯' : '▭'}}</text>
              <text class="fs-label">{{landscape ? '竖屏' : '横屏'}}</text>
            </view>
          </block>
        </view>

        <swiper class="slide-swiper" current="{{slideIndex}}" bindchange="onSwiperChange" duration="200">
          <swiper-item wx:for="{{currentSlides}}" wx:key="id">
            <view class="slide-box" bindtap="onSlideTap" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
              <!-- 双指缩放用 CSS transform；单指滑动交给 swiper 翻页 -->
              <image wx:if="{{item.cover}}" class="slide-img" src="{{item.cover}}" mode="aspectFit"
                     style="transform: translate({{offsetX}}px, {{offsetY}}px) scale({{zoom}});"></image>
              <view wx:else class="slide-empty">该页暂无图片</view>
            </view>
          </swiper-item>
        </swiper>
      </view>

      <!-- 下方：缩略图预览 + 课件切换栏（全屏时隐藏） -->
      <view wx:if="{{!fullscreen}}" class="bottom-bar">
        <scroll-view class="pres-tabs" scroll-x>
          <view class="pres-tab {{index === presIndex ? 'active' : ''}}" wx:for="{{presentations}}" wx:key="id"
                data-index="{{index}}" bindtap="switchPres">{{item.title}}（{{item.slidesCount}}页）</view>
        </scroll-view>
        <scroll-view class="thumbs" scroll-x scroll-left="{{thumbScrollLeft}}">
          <view class="thumb {{index === slideIndex ? 'active' : ''}}" wx:for="{{currentSlides}}" wx:key="id"
                data-index="{{index}}" bindtap="goSlide">
            <image wx:if="{{item.cover}}" class="thumb-img" src="{{item.cover}}" mode="aspectFill" lazy-load></image>
            <view wx:else class="thumb-empty">—</view>
            <text class="thumb-page">{{item.page}}</text>
            <view wx:if="{{item.problem}}" class="thumb-dot"></view>
          </view>
        </scroll-view>
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && presentations.length === 0 && !error}}" class="empty-tip">
    该课时暂无可展示课件
  </view>
</view>
