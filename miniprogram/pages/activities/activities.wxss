.page { min-height: 100vh; padding: 28rpx 24rpx; }
.hint-line { font-size: 24rpx; color: #8E8E93; text-align: center; margin-bottom: 24rpx; }
.activity-item {
  display: flex; align-items: center; gap: 20rpx; background: #fff;
  border-radius: 24rpx; padding: 24rpx; margin-bottom: 16rpx;
}
.type-icon {
  width: 72rpx; height: 72rpx; border-radius: 20rpx; background: #EAF2FF; color: #007AFF;
  font-size: 22rpx; font-weight: 600; text-align: center; line-height: 72rpx; flex-shrink: 0;
}
.type-icon.exam { background: #FFF3E8; color: #FF9500; }
.activity-body { flex: 1; min-width: 0; }
.activity-title { display: block; font-size: 28rpx; font-weight: 600; }
.activity-meta { display: block; font-size: 22rpx; color: #8E8E93; margin-top: 8rpx; }
.done { color: #34C759; font-size: 28rpx; }
.arrow { color: #C7C7CC; font-size: 36rpx; }
.error-box { background: #FFF1F0; color: #CF4C4C; border-radius: 16rpx; padding: 20rpx; font-size: 24rpx; }
