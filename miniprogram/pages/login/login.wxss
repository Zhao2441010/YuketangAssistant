.page { min-height: 100vh; padding: 40rpx 32rpx; }
.head { text-align: center; padding: 40rpx 0 32rpx; }
.logo {
  width: 96rpx; height: 96rpx; line-height: 96rpx; margin: 0 auto 20rpx;
  border-radius: 28rpx; background: #007AFF; color: #fff; font-size: 44rpx; font-weight: 700;
}
.title { display: block; font-size: 36rpx; font-weight: 700; }
.subtitle { display: block; font-size: 24rpx; color: #8E8E93; margin-top: 8rpx; }
.tabs { display: flex; background: #E5E5EA; border-radius: 16rpx; padding: 6rpx; margin: 24rpx 0; }
.tab { flex: 1; text-align: center; padding: 14rpx 0; font-size: 26rpx; color: #8E8E93; border-radius: 12rpx; }
.tab.active { background: #fff; color: #007AFF; font-weight: 600; }
.panel { background: #fff; border-radius: 28rpx; padding: 32rpx; min-height: 400rpx; }
.center { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 360rpx; gap: 20rpx; }
.main-btn { width: 100%; margin-top: 24rpx; }
.ghost-btn { width: 100%; background: #F2F2F7; color: #3A3A3C; font-size: 26rpx; }
.qr-img { width: 400rpx; height: 400rpx; }
.tip { font-size: 24rpx; color: #3A3A3C; }
.countdown { font-size: 24rpx; color: #8E8E93; }
.success-icon { font-size: 80rpx; color: #34C759; }
.success-text { font-size: 30rpx; color: #34C759; font-weight: 600; }
.field {
  width: 100%; height: 88rpx; background: #F2F2F7; border-radius: 16rpx;
  padding: 0 24rpx; margin-bottom: 20rpx; font-size: 28rpx;
}
.hint { display: block; font-size: 22rpx; color: #AEAEB2; margin-top: 20rpx; line-height: 1.6; }
.error-box { background: #FFF1F0; color: #CF4C4C; border-radius: 16rpx; padding: 20rpx; margin-top: 20rpx; font-size: 24rpx; }
.settings-card { background: #fff; border-radius: 20rpx; margin-top: 24rpx; overflow: hidden; }
.settings-head { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; }
.settings-title { font-size: 26rpx; font-weight: 600; }
.settings-toggle { font-size: 22rpx; color: #007AFF; }
.settings-body { padding: 0 24rpx 24rpx; }
.hint { display: block; font-size: 20rpx; color: #8E8E93; line-height: 1.6; margin-bottom: 12rpx; word-break: break-all; }
.privacy { display: block; text-align: center; font-size: 20rpx; color: #AEAEB2; margin-top: 40rpx; }
