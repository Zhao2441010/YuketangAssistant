.page { min-height: 100vh; padding: 28rpx 24rpx; }
.hint-line { font-size: 24rpx; color: #8E8E93; text-align: center; margin-bottom: 24rpx; }
.course-item {
  display: flex; align-items: center; gap: 20rpx; background: #fff;
  border-radius: 28rpx; padding: 28rpx; margin-bottom: 16rpx;
}
.course-icon {
  width: 80rpx; height: 80rpx; border-radius: 22rpx; background: #EAF2FF;
  color: #007AFF; font-size: 32rpx; font-weight: 700; text-align: center; line-height: 80rpx; flex-shrink: 0;
}
.course-body { flex: 1; min-width: 0; }
.course-name { display: block; font-size: 30rpx; font-weight: 700; }
.course-meta { display: block; font-size: 22rpx; color: #8E8E93; margin-top: 8rpx; }
.badge { background: #E8F8ED; color: #34C759; font-size: 20rpx; padding: 6rpx 12rpx; border-radius: 20rpx; }
.arrow { color: #C7C7CC; font-size: 36rpx; }
.error-box { background: #FFF1F0; color: #CF4C4C; border-radius: 16rpx; padding: 20rpx; font-size: 24rpx; }
