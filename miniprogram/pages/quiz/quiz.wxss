.page { min-height: 100vh; padding: 28rpx 24rpx 60rpx; }
.hint-line { font-size: 22rpx; color: #8E8E93; text-align: center; margin-bottom: 24rpx; }
.quiz-card { background: #fff; border-radius: 28rpx; padding: 28rpx; margin-bottom: 20rpx; }
.q-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.q-type { background: #EAF2FF; color: #007AFF; font-size: 20rpx; padding: 6rpx 14rpx; border-radius: 16rpx; }
.q-status { background: #E8F8ED; color: #34C759; font-size: 20rpx; padding: 6rpx 14rpx; border-radius: 16rpx; }
.q-body { display: block; font-size: 28rpx; font-weight: 600; line-height: 1.5; margin-bottom: 20rpx; }
.options { display: flex; flex-direction: column; gap: 12rpx; }
.opt { display: flex; align-items: center; gap: 16rpx; padding: 18rpx; border: 2rpx solid #EEE; border-radius: 16rpx; }
.opt.selected { border-color: #007AFF; background: #F0F7FF; }
.opt-key { width: 44rpx; height: 44rpx; border-radius: 50%; background: #F2F2F7; text-align: center; line-height: 44rpx; font-size: 24rpx; flex-shrink: 0; }
.opt.selected .opt-key { background: #007AFF; color: #fff; }
.opt-value { font-size: 26rpx; flex: 1; }
.blanks { display: flex; flex-direction: column; gap: 12rpx; }
.blank-input { height: 80rpx; background: #F2F2F7; border-radius: 14rpx; padding: 0 20rpx; font-size: 26rpx; }
.subjective { width: 100%; height: 180rpx; background: #F2F2F7; border-radius: 14rpx; padding: 20rpx; font-size: 26rpx; }
.submit-btn { margin-top: 24rpx; font-size: 26rpx; }
.submit-msg { display: block; font-size: 22rpx; color: #34C759; margin-top: 12rpx; text-align: center; }
.error-box { background: #FFF1F0; color: #CF4C4C; border-radius: 16rpx; padding: 20rpx; font-size: 24rpx; }
