page {
  min-height: 100%;
  background: #F2F2F7;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}
view, text, input, button { box-sizing: border-box; }
button { border-radius: 16rpx; }
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.primary-btn {
  background: #007AFF;
  color: #fff;
  font-weight: 600;
  border: none;
}
.primary-btn::after { border: none; }
.muted { color: #8E8E93; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.empty-tip { text-align: center; color: #8E8E93; padding: 80rpx 0; font-size: 26rpx; }
