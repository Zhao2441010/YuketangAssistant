<view class="page">
  <view class="hint-line">随堂题 · 倒计时结束老师未收题仍可补交</view>
  <view wx:if="{{loading}}" class="empty-tip">正在加载题目…</view>
  <view wx:if="{{error}}" class="error-box">{{error}}</view>

  <view wx:if="{{!loading && quizzes.length === 0 && !error}}" class="empty-tip">当前课堂暂无题目</view>

  <view class="quiz-card" wx:for="{{quizzes}}" wx:key="quizId">
    <view class="q-head">
      <text class="q-type">{{item.questionType}}</text>
      <text wx:if="{{item.statusText}}" class="q-status">{{item.statusText}}</text>
    </view>
    <text class="q-body">{{item.body}}</text>

    <!-- 选择题 -->
    <view wx:if="{{item.isChoice}}" class="options">
      <view class="opt {{opt.selected ? 'selected' : ''}}"
            wx:for="{{item.optionList}}" wx:for-item="opt" wx:key="key"
            data-qid="{{item.quizId}}" data-key="{{opt.key}}" bindtap="toggleChoice">
        <text class="opt-key">{{opt.key}}</text>
        <text class="opt-value">{{opt.value}}</text>
      </view>
    </view>

    <!-- 填空 -->
    <view wx:elif="{{item.isBlank}}" class="blanks">
      <input class="blank-input" wx:for="{{item.blanks}}" wx:for-item="b" wx:index="bi" wx:key="bi"
             placeholder="第{{bi + 1}}空" data-qid="{{item.quizId}}" data-index="{{bi}}" bindinput="onBlankInput" />
    </view>

    <!-- 主观 -->
    <textarea wx:else class="subjective" placeholder="输入答案" data-qid="{{item.quizId}}" bindinput="onSubjectiveInput" />

    <button class="primary-btn submit-btn" data-qid="{{item.quizId}}" bindtap="submitAnswer" loading="{{answers[item.quizId].submitting}}">提交答案</button>
    <text wx:if="{{answers[item.quizId].msg}}" class="submit-msg">{{answers[item.quizId].msg}}</text>
  </view>
</view>
